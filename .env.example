# HomeIQ App - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to source control

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Backend API Configuration
API_BASE_URL=https://api.homeiq.com
API_TIMEOUT=30000

# Firebase Configuration (if using)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# AWS S3 (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=homeiq-assets
AWS_REGION=us-east-1

# Google Maps API (for tracking)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Feature Flags
ENABLE_AI_FEATURES=false
ENABLE_PAYMENT_GATEWAY=false
ENABLE_PUSH_NOTIFICATIONS=false

# Environment
NODE_ENV=development
