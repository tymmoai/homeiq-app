<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for development and production.

  In debug builds, cleartext (HTTP) traffic is allowed to local dev servers
  (localhost, 10.0.2.2 for Android emulator, and common LAN ranges).
  In release builds, only HTTPS is allowed.
-->
<network-security-config>
    <!-- Allow cleartext only in debug builds for local development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Allow cleartext to common development servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Default: allow cleartext for now (change to false for production HTTPS) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
